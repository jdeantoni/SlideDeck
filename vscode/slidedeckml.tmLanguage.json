{
  "name": "SlideDeckML",
  "scopeName": "source.slidedeckml",
  "patterns": [
    { "include": "#comment" },
    { "include": "#code" },
    { "include": "#metadata" },
    { "include": "#block" },
    { "include": "#inline" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.double-slash.slidedeckml", "match": "^\\s*//.*$" },
        { "name": "comment.block.slidedeckml", "begin": "^\\s*/\\*", "end": "\\*/" }
      ]
    },
    "code": {
      "patterns": [
        {
          "name": "markup.raw.block.slidedeckml",
          "begin": "^\\s*(```)([\\w-]*)(?:\\s*(\\[[^]]*\\]))?\\s*$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.raw.begin.slidedeckml" },
            "2": { "name": "entity.name.language.slidedeckml" },
            "3": { "name": "meta.attributes.slidedeckml" }
          },
          "end": "^\\s*```\\s*$",
          "endCaptures": { "0": { "name": "punctuation.definition.raw.end.slidedeckml" } }
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "begin": "^\\s*\\{\\s*$",
          "end": "^\\s*\\}\\s*$",
          "name": "meta.metadata.slidedeckml",
          "patterns": [
            { "name": "variable.other.property.slidedeckml", "match": "\\b(?:author|title|theme|logo|css|transition|chalkboard(?:-[a-z-]+)?)\\b(?=\\s*:)" },
            { "name": "string.quoted.double.slidedeckml", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.slidedeckml", "match": "\\\\." }] },
            { "include": "#comment" }
          ]
        }
      ]
    },
    "block": {
      "patterns": [
        { "name": "keyword.control.separator.slidedeckml", "match": "^\\s*===\\s*$" },
        { "name": "keyword.control.directive.slidedeckml", "match": ":{3,4}(?:quiz|\\[sync-fragments(?:\\s+keep)?\\])?" },
        { "name": "keyword.control.list.slidedeckml", "match": "^\\s*(?:[-+*]|\\d+\\.)\\s+" },
        { "name": "punctuation.definition.heading.slidedeckml", "match": "^\\s*#{1,3}(?=\\s)" },
        { "name": "punctuation.definition.quote.slidedeckml", "match": "^\\s*>\\s*" }
      ]
    },
    "inline": {
      "patterns": [
        { "name": "constant.character.escape.slidedeckml", "match": "\\\\[\\[\\]{}\\\\]" },
        { "name": "string.other.link.slidedeckml", "match": "!\\[[^\\]]+\\](?:\\([^\\r\\n)]*\\)|\\s+\"[^\"\\r\\n]*\")" },
        {
          "name": "meta.inline-attributes.slidedeckml",
          "begin": "(?<=\\])\\{",
          "end": "\\}",
          "patterns": [
            { "name": "entity.other.attribute-name.class.slidedeckml", "match": "\\.[a-zA-Z][\\w-]*" },
            { "name": "variable.other.property.slidedeckml", "match": "[\\w-]+(?=\\s*:)" },
            { "name": "string.quoted.single.slidedeckml", "begin": "'", "end": "'", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.slidedeckml" }] },
            { "name": "string.quoted.double.slidedeckml", "begin": "\"", "end": "\"", "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.slidedeckml" }] }
          ]
        },
        { "name": "markup.bold.slidedeckml", "match": "\\*\\*[^*]+\\*\\*" },
        { "name": "markup.underline.slidedeckml", "match": "__[^_]+__" },
        { "name": "markup.italic.slidedeckml", "match": "(?<!\\*)\\*[^*]+\\*|(?<!_)_[^_]+_" },
        { "name": "entity.other.attribute-name.class.slidedeckml", "match": "(?<=\\{|\\s)\\.[a-zA-Z][\\w-]*" },
        { "name": "variable.other.property.slidedeckml", "match": "\\b(?:animate|transition|index|font-size|color|width|height|background|text-align)(?=\\s*:)" },
        { "name": "string.quoted.single.slidedeckml", "match": "(?<=:\\s)'[^'\\r\\n]*'" },
        { "name": "string.quoted.double.slidedeckml", "match": "(?<=:\\s)\"[^\"\\r\\n]*\"" }
      ]
    }
  }
}
