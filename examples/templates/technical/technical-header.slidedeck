{
    author: "Your Name"
    title: "Your Presentation"
    theme: "black"
    css: ".reveal h1 {
                color: #61dafb;
                font-weight: 700;
                font-family: 'Courier New', monospace;
            }
            .reveal h2 {
                color: #98c379;
                font-weight: 600;
                font-family: 'Courier New', monospace;
            }
            .reveal h3 {
                color: #c678dd;
                font-weight: 500;
            }
            .header-banner {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 45px;
                background-color: #1e1e1e;
                border-bottom: 2px solid #61dafb;
                display: flex;
                align-items: center;
                justify-content: space-between;
                z-index: 1000;
            }
            .header-author {
                color: #61dafb;
                font-size: 14px;
                font-weight: 500;
                margin-left: 20px;
                font-family: 'Courier New', monospace;
            }
            .header-logo {
                height: 30px;
                width: auto;
                margin-right: 20px;
            }
            .reveal {
                margin-top: 45px;
            }
            .reveal code {
                background: #282c34;
                color: #61dafb;
                padding: 3px 8px;
                border-radius: 4px;
            }
            .reveal pre {
                background: #282c34;
                border: 1px solid #61dafb;
                border-radius: 8px;
            }
            .reveal strong {
                color: #e06c75;
            }"
}
