{
  "name": "slidedeck",
  "displayName": "SlideDeck",
  "publisher": "slidedeck",
  "version": "1.0.9",
  "description": "A DSL for creating reveal.js slides from extended markdown",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdeantoni/SlideDeck.git"
  },
  "main": "./out/extension.js",
  "bin": {
    "slidedeck": "./out/cli/main.js"
  },
  "activationEvents": [
    "onLanguage:slidedeck",
    "onCommand:slidedeck.openPreview",
    "onCommand:slidedeck.compileHtml",
    "onCommand:slidedeck.startPresentation"
  ],
  "contributes": {
    "languages": [
      {
        "id": "slidedeck",
        "aliases": [
          "SlideDeck"
        ],
        "extensions": [
          ".slidedeck",
          ".sdml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "slidedeck",
        "scopeName": "source.slidedeck",
        "path": "./vscode/slidedeck.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "slidedeck",
        "path": "./vscode/slidedeck.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "slidedeck.openPreview",
        "title": "SlideDeck: Open Preview to the Side",
        "icon": "$(open-preview)"
      },
      {
        "command": "slidedeck.compileHtml",
        "title": "SlideDeck: Generate HTML",
        "icon": "$(export)"
      },
      {
        "command": "slidedeck.startPresentation",
        "title": "SlideDeck: Start Presentation",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "slidedeck.openPreview",
          "when": "editorLangId == slidedeck",
          "group": "navigation@1"
        },
        {
          "command": "slidedeck.compileHtml",
          "when": "editorLangId == slidedeck",
          "group": "navigation@2"
        },
        {
          "command": "slidedeck.startPresentation",
          "when": "editorLangId == slidedeck",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "SlideDeck",
      "properties": {
        "slidedeck.browserExecutable": {
          "type": "string",
          "default": "firefox",
          "scope": "machine",
          "description": "Browser executable or absolute path used to start a presentation."
        },
        "slidedeck.browserArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--new-window"
          ],
          "scope": "machine",
          "description": "Arguments passed to the browser before the presentation URL."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Preview executes presentation scripts and accesses local assets."
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "langium:generate": "langium generate",
    "langium:watch": "langium generate --watch",
    "compile": "node ./out/cli/main.js compile",
    "dev": "node ./out/cli/main.js dev",
    "quiz-server": "node ./standalone-quiz-server/start-server.js"
  },
  "keywords": [
    "langium",
    "dsl",
    "markdown",
    "reveal.js",
    "slides"
  ],
  "author": "Baptiste Lacroix,Roxane Bacon, Baptiste Royer, Théo Vidal, Julien Deantoni",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "chevrotain": "^10.4.1",
    "commander": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "langium": "~1.0.0",
    "moment": "^2.29.4",
    "open": "^8.4.0",
    "socket.io": "^4.5.4",
    "vscode-languageclient": "^8.0.2",
    "vscode-languageserver": "^8.0.2",
    "vscode-uri": "^3.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^14.17.3",
    "@types/vscode": "^1.56.0",
    "@typescript-eslint/eslint-plugin": "^5.28.0",
    "@typescript-eslint/parser": "^5.28.0",
    "langium-cli": "~1.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "vscode": "^1.67.0"
  }
}
